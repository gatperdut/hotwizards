{
  "name": "hotwizards",
  "description": "Hot Wizards Monorepo",
  "type": "module",
  "author": "carlosrb",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "hwbe:start": "pnpm --filter @hw/hwbe start",
    "hwbe:build": "pnpm --filter @hw/hwbe build",
    "hwbe:clear": "pnpm --filter @hw/hwbe run clear",
    "hwfe:start": "pnpm --filter @hw/hwfe start",
    "hwfe:build": "pnpm --filter @hw/hwfe build",
    "hwfe:build:stats": "pnpm --filter @hw/hwfe build:stats",
    "hwfe:clear": "pnpm --filter @hw/hwfe run clear",
    "shared:start": "pnpm --filter @hw/shared start",
    "shared:build": "pnpm --filter @hw/shared build",
    "shared:clear": "pnpm --filter @hw/shared run clear",
    "prismagen:generate": "pnpm --filter @hw/prismagen generate",
    "prismagen:migrate:dev": "pnpm --filter @hw/prismagen migrate:dev",
    "prismagen:migrate:deploy": "pnpm --filter @hw/prismagen migrate:deploy",
    "prismagen:migrate:reset": "pnpm --filter @hw/prismagen migrate:reset",
    "prismagen:studio": "pnpm --filter @hw/prismagen studio",
    "prismagen:clear": "pnpm --filter @hw/prismagen run clear",
    "seeds:seed": "pnpm --filter @hw/seeds seed",
    "seeds:seed:dev": "pnpm --filter @hw/seeds seed:dev",
    "seeds:seed:prod": "pnpm --filter @hw/seeds seed:prod",
    "seeds:clear": "pnpm --filter @hw/seeds clear",
    "db:up": "docker-compose -f docker-compose.dev.yml up -d --wait",
    "db:down": "docker-compose -f docker-compose.dev.yml down",
    "db:nuke": "docker-compose -f docker-compose.dev.yml down -v",
    "db:logs": "docker-compose -f docker-compose.dev.yml logs -f db",
    "db:psql": "docker-compose -f docker-compose.dev.yml exec db sh -c 'psql -U \"$POSTGRES_USER\" \"$POSTGRES_DB\"'",
    "clear": "pnpm run hwbe:clear && pnpm run hwfe:clear && pnpm run shared:clear && pnpm run prismagen:clear && pnpm run seeds:clear",
    "reset:dev": "./scripts/reset-dev.sh",
    "reset:prod": "./scripts/reset-prod.sh"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.1.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "^17.0.0",
    "prettier": "^3.8.1",
    "typescript-eslint": "8.58.0",
    "typescript": "^6.0.3"
  }
}
