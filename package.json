{
  "name": "hotwizards",
  "description": "Hot Wizards Monorepo",
  "type": "module",
  "author": "carlosrb",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "hwbe:start": "pnpm --filter @hw/hwbe start",
    "hwbe:start:debug": "pnpm --filter @hw/hwbe start:debug",
    "hwbe:build": "pnpm --filter @hw/hwbe build",
    "hwbe:clean": "pnpm --filter @hw/hwbe clean",
    "hwbe:prisma:migrate:dev": "pnpm --filter @hw/hwbe prisma:migrate:dev",
    "hwbe:prisma:migrate:deploy": "pnpm --filter @hw/hwbe prisma:migrate:deploy",
    "hwbe:prisma:migrate:reset": "pnpm --filter @hw/hwbe prisma:migrate:reset",
    "hwbe:prisma:db:seed": "pnpm --filter @hw/hwbe prisma:db:seed",
    "hwbe:prisma:studio": "pnpm --filter @hw/hwbe prisma:studio",
    "hwfe:start": "pnpm --filter @hw/hwfe start",
    "hwfe:start:wifi": "pnpm --filter @hw/hwfe start:wifi",
    "hwfe:build": "pnpm --filter @hw/hwfe build",
    "hwfe:build:dev": "pnpm --filter @hw/hwfe build:dev",
    "hwfe:build:watch": "pnpm --filter @hw/hwfe build:watch",
    "hwfe:build:stats": "pnpm --filter @hw/hwfe build:stats",
    "hwfe:clean": "pnpm --filter @hw/hwfe clean",
    "shared:start": "pnpm --filter @hw/shared start",
    "shared:build": "pnpm --filter @hw/shared build",
    "shared:clean": "pnpm --filter @hw/shared clean",
    "prismagen:clean": "pnpm --filter @hw/prismagen clean",
    "prismagen:generate": "pnpm --filter @hw/prismagen generate",
    "reset:db": "npm run hwbe:prisma:migrate:reset",
    "reset:schema": "./scripts/reset-schema.sh",
    "reset:dev": "./scripts/reset-dev.sh",
    "reset:prod": "./scripts/reset-prod.sh",
    "clean": "rm -rf node_modules hwbe/node_modules hwfe/node_modules shared/node_modules prismagen/node_modules",
    "clean:all": "npm run hwbe:clean && npm run hwfe:clean && npm run shared:clean && npm run prismagen:clean && npm run clean"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.1.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "^3.8.1",
    "tslib": "^2.3.0",
    "typescript-eslint": "8.58.0",
    "typescript": "^5.9.2"
  }
}
