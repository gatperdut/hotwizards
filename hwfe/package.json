    "@angular/service-worker": "^22.1.1",
    "@sentry/angular": "^10.47.0",
    "pixi.js": "^8.18.1",
    "pixi-viewport": "^6.0.3",
    "rxjs": "^7.8.2",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@angular/build": "^22.1.3",
    "@angular/cli": "^22.1.3",
    "@angular/compiler-cli": "^22.1.1",
    "@tailwindcss/postcss": "^4.1.12",
