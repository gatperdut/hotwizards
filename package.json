{
  "name": "hotwizards",
  "description": "Hot Wizards Monorepo",
  "type": "module",
  "author": "carlosrb",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "hwbe:start": "pnpm --filter @hw/hwbe start",
    "hwbe:start:debug": "pnpm --filter @hw/hwbe start:debug",
    "hwbe:build": "pnpm --filter @hw/hwbe build",
    "hwbe:clean": "pnpm --filter @hw/hwbe run clean",
    "hwfe:start": "pnpm --filter @hw/hwfe start",
    "hwfe:start:wifi": "pnpm --filter @hw/hwfe start:wifi",
    "hwfe:build": "pnpm --filter @hw/hwfe build",
    "hwfe:build:dev": "pnpm --filter @hw/hwfe build:dev",
    "hwfe:build:watch": "pnpm --filter @hw/hwfe build:watch",
    "hwfe:build:stats": "pnpm --filter @hw/hwfe build:stats",
    "hwfe:clean": "pnpm --filter @hw/hwfe run clean",
    "shared:start": "pnpm --filter @hw/shared start",
    "shared:build": "pnpm --filter @hw/shared build",
    "shared:clean": "pnpm --filter @hw/shared run clean",
    "prismagen:generate": "pnpm --filter @hw/prismagen generate",
    "prismagen:clean": "pnpm --filter @hw/prismagen run clean",
    "prismagen:migrate:dev": "pnpm --filter @hw/prismagen migrate:dev",
    "prismagen:migrate:deploy": "pnpm --filter @hw/prismagen migrate:deploy",
    "prismagen:migrate:reset": "pnpm --filter @hw/prismagen migrate:reset",
    "prismagen:seed": "pnpm --filter @hw/prismagen seed",
    "prismagen:studio": "pnpm --filter @hw/prismagen studio",
    "reset:dev:db": "pnpm run prismagen:migrate:reset",
    "reset:dev:schema": "./scripts/reset-schema.sh",
    "reset:dev": "./scripts/reset-dev.sh",
    "reset:prod": "./scripts/reset-prod.sh",
    "clean": "rm -rf node_modules hwbe/node_modules hwfe/node_modules shared/node_modules prismagen/node_modules",
    "clean:all": "pnpm run hwbe:clean && pnpm run hwfe:clean && pnpm run shared:clean && pnpm run prismagen:clean && pnpm run clean"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.1.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "^17.0.0",
    "prettier": "^3.8.1",
    "typescript-eslint": "8.58.0",
    "typescript": "^6.0.3"
  }
}
